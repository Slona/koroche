# Copy to .env (local) or /etc/koroche.env (server, chmod 600)
# generate with: openssl rand -hex 32
SESSION_SECRET=
SHORT_HOST=4cm.su
PANEL_HOST=web.4cm.su
SCHEME=https
PORT=3010
DB_PATH=/var/lib/koroche/koroche.sqlite
# VK ID application id; LEGACY_OWNER_VK_ID = owner of pre-existing links (one-off migration)
VK_CLIENT_ID=
LEGACY_OWNER_VK_ID=
# Local development only: login without VK at /auth/dev
# DEV_LOGIN=1
# DEV_VK_ID=1
# Local development with a port:
# SHORT_ORIGIN=http://short.localhost:3011
# PANEL_ORIGIN=http://panel.localhost:3011
