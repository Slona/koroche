# Скопировать в .env (локально) или /etc/koroche.env (сервер, chmod 600)
SESSION_SECRET=сгенерировать: openssl rand -hex 32
SHORT_HOST=4cm.su
PANEL_HOST=web.4cm.su
SCHEME=https
PORT=3010
DB_PATH=/var/lib/koroche/koroche.sqlite
# VK ID: ID приложения; LEGACY_OWNER_VK_ID — владелец старых ссылок (разовая миграция)
VK_CLIENT_ID=
LEGACY_OWNER_VK_ID=
# Только для локальной разработки: вход без VK по /auth/dev
# DEV_LOGIN=1
# DEV_VK_ID=1
# Для локальной разработки с портом:
# SHORT_ORIGIN=http://short.localhost:3011
# PANEL_ORIGIN=http://panel.localhost:3011
