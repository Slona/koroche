# Оба домена проксируются на один процесс; сервис различает их по заголовку Host.
server {
    listen 443 ssl http2;
    server_name 4cm.su web.4cm.su;          # замените на свои домены
    ssl_certificate     /etc/letsencrypt/live/4cm.su/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/4cm.su/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
